# Copy to .env.local (never committed) and fill in.

# ---- MongoDB (fast working store) ----
# Local development: run `npm run db:local`, then use the local URI below.
# Demo: MongoDB Atlas connection string. Production: client's cluster.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=seg

# ---- BigQuery (source of truth) ----
GCP_PROJECT_ID=
# Path to the service-account key file (local), or leave empty and set GCP_KEY_BASE64 (Vercel).
GOOGLE_APPLICATION_CREDENTIALS=.secrets/gcp-key.json
GCP_KEY_BASE64=
# Demo datasets. Production: BUSINESS_INTELLIGENCE_LAYER_PROD / BUSINESS_INTELLIGENCE_WEBAPP_LAYER_PROD
BQ_SOURCE_DATASET=seg_source
BQ_APP_DATASET=seg_app
BQ_LOCATION=US

# ---- Adapters (demo vs production) ----
# credentials = email + password from MongoDB (demo) | entra = Microsoft Entra ID (production)
AUTH_PROVIDER=credentials
# none = keep edits in MongoDB only | bigquery = append edits to BigQuery
WRITEBACK=none

# ---- Auth ----
# Long random string used to sign session cookies: `openssl rand -base64 32`
AUTH_SECRET=
# Password for the seeded demo users
DEMO_PASSWORD=SegDemo!2026

# ---- Jobs ----
# Shared secret that Vercel Cron (or the client's scheduler) sends to /api/jobs/*
CRON_SECRET=

# ---- Links ----
MAIN_MENU_URL=
