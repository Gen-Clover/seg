{
  "name": "@seg/seed",
  "version": "0.1.0",
  "private": true,
  "description": "Demo data: generates fictional source data in the legacy BigQuery layout and loads it into BigQuery and MongoDB.",
  "type": "module",
  "scripts": {
    "generate": "tsx src/generate.ts",
    "load:mongo": "tsx src/load-mongo.ts",
